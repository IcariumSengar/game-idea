[gd_scene load_steps=4 format=3 uid="uid://run_prep"]

[ext_resource type="Script" path="res://scripts/run_prep.gd" id="1_prep"]
[ext_resource type="Script" path="res://scripts/night_sky_background.gd" id="2_sky"]
[ext_resource type="StyleBoxFlat" path="res://resources/panel_dark.tres" id="3_panel_dark"]
[ext_resource type="Script" path="res://scripts/menu_link_button.gd" id="4_link"]

[node name="RunPrep" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_prep")

[node name="NightSky" type="Control" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("2_sky")

[node name="CenterContainer" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="OuterVBox" type="VBoxContainer" parent="CenterContainer"]
layout_mode = 2
theme_override_constants/separation = 24

[node name="Panel" type="PanelContainer" parent="CenterContainer/OuterVBox"]
layout_mode = 2
theme_override_styles/panel = ExtResource("3_panel_dark")

[node name="Margin" type="MarginContainer" parent="CenterContainer/OuterVBox/Panel"]
layout_mode = 2
theme_override_constants/margin_left = 40
theme_override_constants/margin_top = 32
theme_override_constants/margin_right = 40
theme_override_constants/margin_bottom = 32

[node name="VBoxContainer" type="VBoxContainer" parent="CenterContainer/OuterVBox/Panel/Margin"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="TitleLabel" type="Label" parent="CenterContainer/OuterVBox/Panel/Margin/VBoxContainer"]
layout_mode = 2
theme_override_font_sizes/font_size = 40
theme_override_colors/font_color = Color(0.92, 0.82, 0.55, 1)
text = "EMBARK?"
horizontal_alignment = 1

[node name="ProgressLabel" type="Label" parent="CenterContainer/OuterVBox/Panel/Margin/VBoxContainer"]
unique_name_in_owner = true
custom_minimum_size = Vector2(400, 0)
layout_mode = 2
theme_override_font_sizes/font_size = 14
theme_override_colors/font_color = Color(0.85, 0.85, 0.82, 1)
text = "Your Hoard"
horizontal_alignment = 0
vertical_alignment = 1

[node name="AbilityLabel" type="Label" parent="CenterContainer/OuterVBox/Panel/Margin/VBoxContainer"]
layout_mode = 2
theme_override_font_sizes/font_size = 13
theme_override_colors/font_color = Color(0.65, 0.7, 0.65, 1)
text = "BACKPACK ABILITY"
horizontal_alignment = 1

[node name="AbilityRow" type="HBoxContainer" parent="CenterContainer/OuterVBox/Panel/Margin/VBoxContainer"]
layout_mode = 2
theme_override_constants/separation = 12
alignment = 1

[node name="CondenseButton" type="Button" parent="CenterContainer/OuterVBox/Panel/Margin/VBoxContainer/AbilityRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(150, 30)
theme_override_font_sizes/font_size = 15
text = "Condense"
script = ExtResource("4_link")

[node name="ClearButton" type="Button" parent="CenterContainer/OuterVBox/Panel/Margin/VBoxContainer/AbilityRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(150, 30)
theme_override_font_sizes/font_size = 15
text = "Clear"
script = ExtResource("4_link")

[node name="ButtonContainer" type="VBoxContainer" parent="CenterContainer/OuterVBox"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="StartRunButton" type="Button" parent="CenterContainer/OuterVBox/ButtonContainer"]
custom_minimum_size = Vector2(400, 36)
layout_mode = 2
theme_override_font_sizes/font_size = 22
text = "START RUN"
script = ExtResource("4_link")

[node name="ViewTreeButton" type="Button" parent="CenterContainer/OuterVBox/ButtonContainer"]
custom_minimum_size = Vector2(400, 36)
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "ENTER SANCTUM"
script = ExtResource("4_link")

[node name="BackButton" type="Button" parent="CenterContainer/OuterVBox/ButtonContainer"]
custom_minimum_size = Vector2(400, 36)
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "← BACK"
script = ExtResource("4_link")

[connection signal="pressed" from="CenterContainer/OuterVBox/Panel/Margin/VBoxContainer/AbilityRow/CondenseButton" to="." method="_on_condense_pressed"]
[connection signal="pressed" from="CenterContainer/OuterVBox/Panel/Margin/VBoxContainer/AbilityRow/ClearButton" to="." method="_on_clear_pressed"]
[connection signal="pressed" from="CenterContainer/OuterVBox/ButtonContainer/StartRunButton" to="." method="_on_start_run_pressed"]
[connection signal="pressed" from="CenterContainer/OuterVBox/ButtonContainer/ViewTreeButton" to="." method="_on_view_tree_pressed"]
[connection signal="pressed" from="CenterContainer/OuterVBox/ButtonContainer/BackButton" to="." method="_on_back_pressed"]
