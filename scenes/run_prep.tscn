[gd_scene load_steps=8 format=3 uid="uid://run_prep"]

[ext_resource type="Script" path="res://scripts/run_prep.gd" id="1_prep"]
[ext_resource type="Script" path="res://scripts/juicy_button.gd" id="2_juicy"]
[ext_resource type="StyleBoxFlat" path="res://resources/panel_dark.tres" id="3_panel_dark"]
[ext_resource type="StyleBoxFlat" path="res://resources/button_normal.tres" id="4_btn_normal"]
[ext_resource type="StyleBoxFlat" path="res://resources/button_hover.tres" id="5_btn_hover"]
[ext_resource type="StyleBoxFlat" path="res://resources/button_pressed.tres" id="6_btn_pressed"]
[ext_resource type="Texture2D" path="res://assets/dungeon_tileset/frames/floor_1.png" id="7_floor_tile"]

[node name="RunPrep" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_prep")

[node name="Background" type="TextureRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
texture = ExtResource("7_floor_tile")
stretch_mode = 1

[node name="Dim" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.05, 0.06, 0.05, 0.55)

[node name="CenterContainer" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Panel" type="PanelContainer" parent="CenterContainer"]
layout_mode = 2
theme_override_styles/panel = ExtResource("3_panel_dark")

[node name="Margin" type="MarginContainer" parent="CenterContainer/Panel"]
layout_mode = 2
theme_override_constants/margin_left = 40
theme_override_constants/margin_top = 32
theme_override_constants/margin_right = 40
theme_override_constants/margin_bottom = 32

[node name="VBoxContainer" type="VBoxContainer" parent="CenterContainer/Panel/Margin"]
layout_mode = 2
theme_override_constants/separation = 24

[node name="TitleLabel" type="Label" parent="CenterContainer/Panel/Margin/VBoxContainer"]
layout_mode = 2
theme_override_font_sizes/font_size = 40
theme_override_colors/font_color = Color(0.92, 0.82, 0.55, 1)
text = "READY?"
horizontal_alignment = 1

[node name="ProgressLabel" type="Label" parent="CenterContainer/Panel/Margin/VBoxContainer"]
custom_minimum_size = Vector2(400, 0)
layout_mode = 2
theme_override_font_sizes/font_size = 14
theme_override_colors/font_color = Color(0.85, 0.85, 0.82, 1)
text = "Current Progress"
horizontal_alignment = 0
vertical_alignment = 1

[node name="ButtonContainer" type="VBoxContainer" parent="CenterContainer/Panel/Margin/VBoxContainer"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="StartRunButton" type="Button" parent="CenterContainer/Panel/Margin/VBoxContainer/ButtonContainer"]
custom_minimum_size = Vector2(400, 48)
layout_mode = 2
theme_override_font_sizes/font_size = 18
theme_override_styles/normal = ExtResource("4_btn_normal")
theme_override_styles/hover = ExtResource("5_btn_hover")
theme_override_styles/pressed = ExtResource("6_btn_pressed")
text = "START RUN"
script = ExtResource("2_juicy")

[node name="ViewTreeButton" type="Button" parent="CenterContainer/Panel/Margin/VBoxContainer/ButtonContainer"]
custom_minimum_size = Vector2(400, 48)
layout_mode = 2
theme_override_font_sizes/font_size = 18
theme_override_styles/normal = ExtResource("4_btn_normal")
theme_override_styles/hover = ExtResource("5_btn_hover")
theme_override_styles/pressed = ExtResource("6_btn_pressed")
text = "VIEW SKILL TREE"
script = ExtResource("2_juicy")

[node name="BackButton" type="Button" parent="CenterContainer/Panel/Margin/VBoxContainer/ButtonContainer"]
custom_minimum_size = Vector2(400, 48)
layout_mode = 2
theme_override_font_sizes/font_size = 18
theme_override_styles/normal = ExtResource("4_btn_normal")
theme_override_styles/hover = ExtResource("5_btn_hover")
theme_override_styles/pressed = ExtResource("6_btn_pressed")
