[gd_scene load_steps=4 format=3 uid="uid://main_menu"]

[ext_resource type="Script" path="res://scripts/main_menu.gd" id="1_menu"]
[ext_resource type="Script" path="res://scripts/night_sky_background.gd" id="2_sky"]
[ext_resource type="Script" path="res://scripts/magic_circle_decor.gd" id="3_circle"]
[ext_resource type="Script" path="res://scripts/menu_link_button.gd" id="4_link"]

[node name="MainMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_menu")

[node name="NightSky" type="Control" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("2_sky")

[node name="CenterContainer" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="MagicCircle" type="Control" parent="CenterContainer"]
custom_minimum_size = Vector2(480, 480)
layout_mode = 2
script = ExtResource("3_circle")

[node name="ContentVBox" type="VBoxContainer" parent="CenterContainer"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="TitleLabel" type="Label" parent="CenterContainer/ContentVBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 52
theme_override_colors/font_color = Color(0.95, 0.92, 0.85, 1)
theme_override_constants/outline_size = 6
theme_override_colors/font_outline_color = Color(0.15, 0.08, 0.2, 0.8)
text = "STARHOARD"
horizontal_alignment = 1

[node name="SubtitleLabel" type="Label" parent="CenterContainer/ContentVBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 14
theme_override_colors/font_color = Color(0.65, 0.6, 0.7, 1)
text = "Hoard what you can. Survive what you must."
horizontal_alignment = 1

[node name="Spacer" type="Control" parent="CenterContainer/ContentVBox"]
custom_minimum_size = Vector2(300, 36)
layout_mode = 2

[node name="NewGameButton" type="Button" parent="CenterContainer/ContentVBox"]
custom_minimum_size = Vector2(300, 40)
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "PLAY"
script = ExtResource("4_link")

[node name="LoadGameButton" type="Button" parent="CenterContainer/ContentVBox"]
custom_minimum_size = Vector2(300, 36)
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "LOAD GAME"
script = ExtResource("4_link")

[node name="SettingsButton" type="Button" parent="CenterContainer/ContentVBox"]
custom_minimum_size = Vector2(300, 36)
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "SETTINGS"
script = ExtResource("4_link")

[node name="QuitButton" type="Button" parent="CenterContainer/ContentVBox"]
custom_minimum_size = Vector2(300, 36)
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "QUIT"
script = ExtResource("4_link")

[node name="Spacer2" type="Control" parent="CenterContainer/ContentVBox"]
custom_minimum_size = Vector2(300, 16)
layout_mode = 2

[node name="VersionLabel" type="Label" parent="CenterContainer/ContentVBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 12
theme_override_colors/font_color = Color(0.55, 0.5, 0.6, 1)
text = "v?"
horizontal_alignment = 1

[connection signal="pressed" from="CenterContainer/ContentVBox/NewGameButton" to="." method="_on_new_game_pressed"]
[connection signal="pressed" from="CenterContainer/ContentVBox/LoadGameButton" to="." method="_on_load_game_pressed"]
[connection signal="pressed" from="CenterContainer/ContentVBox/SettingsButton" to="." method="_on_settings_pressed"]
[connection signal="pressed" from="CenterContainer/ContentVBox/QuitButton" to="." method="_on_quit_pressed"]
