[node name="Weapon" type="Node" parent="Player"]
script = ExtResource("3_weapon")

[node name="AttackTimer" type="Timer" parent="Player/Weapon"]
wait_time = 0.4
autostart = true

[node name="EnemySpawnTimer" type="Timer" parent="."]
wait_time = 1.5
autostart = true

[node name="HUD" type="CanvasLayer" parent="."]
script = ExtResource("4_hud")

[node name="HPLabel" type="Label" parent="HUD"]
offset_left = 16.0
offset_top = 12.0
offset_right = 220.0
offset_bottom = 40.0
theme_override_font_sizes/font_size = 22
text = "HP: 100 / 100"

[node name="LootLabel" type="Label" parent="HUD"]
offset_left = 16.0
