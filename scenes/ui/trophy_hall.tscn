[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/ui/trophy_hall.gd" id="1_trophy"]
[ext_resource type="Script" path="res://scripts/fx/night_sky_background.gd" id="2_sky"]
[ext_resource type="StyleBoxFlat" path="res://resources/panel_dark.tres" id="3_panel_dark"]
[ext_resource type="Script" path="res://scripts/ui/menu_link_button.gd" id="4_link"]

[node name="TrophyHall" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_trophy")

[node name="NightSky" type="Control" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("2_sky")

[node name="CenterContainer" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="OuterVBox" type="VBoxContainer" parent="CenterContainer"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Panel" type="PanelContainer" parent="CenterContainer/OuterVBox"]
custom_minimum_size = Vector2(520, 560)
layout_mode = 2
theme_override_styles/panel = ExtResource("3_panel_dark")

[node name="Margin" type="MarginContainer" parent="CenterContainer/OuterVBox/Panel"]
layout_mode = 2
theme_override_constants/margin_left = 28
theme_override_constants/margin_top = 24
theme_override_constants/margin_right = 28
theme_override_constants/margin_bottom = 20

[node name="VBox" type="VBoxContainer" parent="CenterContainer/OuterVBox/Panel/Margin"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="TitleLabel" type="Label" parent="CenterContainer/OuterVBox/Panel/Margin/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 32
theme_override_colors/font_color = Color(0.92, 0.82, 0.55, 1)
text = "TROPHY HALL"
horizontal_alignment = 1

[node name="ScrollContainer" type="ScrollContainer" parent="CenterContainer/OuterVBox/Panel/Margin/VBox"]
custom_minimum_size = Vector2(460, 420)
layout_mode = 2
size_flags_vertical = 3

[node name="TrophyHallBody" type="RichTextLabel" parent="CenterContainer/OuterVBox/Panel/Margin/VBox/ScrollContainer"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
bbcode_enabled = true
fit_content = true
scroll_active = false
theme_override_font_sizes/normal_font_size = 14
theme_override_font_sizes/bold_font_size = 15

[node name="BackButton" type="Button" parent="CenterContainer/OuterVBox"]
custom_minimum_size = Vector2(400, 36)
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "← BACK"
script = ExtResource("4_link")

[connection signal="pressed" from="CenterContainer/OuterVBox/BackButton" to="." method="_on_back_pressed"]
