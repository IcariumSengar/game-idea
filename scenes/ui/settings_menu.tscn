[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/ui/settings_menu.gd" id="1_settings"]
[ext_resource type="Script" path="res://scripts/fx/night_sky_background.gd" id="2_sky"]
[ext_resource type="StyleBoxFlat" path="res://resources/panel_dark.tres" id="3_panel_dark"]
[ext_resource type="Script" path="res://scripts/ui/menu_link_button.gd" id="4_link"]

[node name="SettingsMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_settings")

[node name="NightSky" type="Control" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("2_sky")

[node name="CenterContainer" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="OuterVBox" type="VBoxContainer" parent="CenterContainer"]
layout_mode = 2
theme_override_constants/separation = 24

[node name="Panel" type="PanelContainer" parent="CenterContainer/OuterVBox"]
layout_mode = 2
theme_override_styles/panel = ExtResource("3_panel_dark")

[node name="Margin" type="MarginContainer" parent="CenterContainer/OuterVBox/Panel"]
layout_mode = 2
theme_override_constants/margin_left = 40
theme_override_constants/margin_top = 32
theme_override_constants/margin_right = 40
theme_override_constants/margin_bottom = 32

[node name="VBoxContainer" type="VBoxContainer" parent="CenterContainer/OuterVBox/Panel/Margin"]
custom_minimum_size = Vector2(360, 0)
layout_mode = 2
theme_override_constants/separation = 18

[node name="TitleLabel" type="Label" parent="CenterContainer/OuterVBox/Panel/Margin/VBoxContainer"]
layout_mode = 2
theme_override_font_sizes/font_size = 32
theme_override_colors/font_color = Color(0.92, 0.82, 0.55, 1)
text = "SETTINGS"
horizontal_alignment = 1

[node name="VolumeRow" type="VBoxContainer" parent="CenterContainer/OuterVBox/Panel/Margin/VBoxContainer"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="VolumeLabelRow" type="HBoxContainer" parent="CenterContainer/OuterVBox/Panel/Margin/VBoxContainer/VolumeRow"]
layout_mode = 2

[node name="VolumeLabel" type="Label" parent="CenterContainer/OuterVBox/Panel/Margin/VBoxContainer/VolumeRow/VolumeLabelRow"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 16
text = "Master Volume"

[node name="VolumeValueLabel" type="Label" parent="CenterContainer/OuterVBox/Panel/Margin/VBoxContainer/VolumeRow/VolumeLabelRow"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 16
theme_override_colors/font_color = Color(0.65, 0.7, 0.65, 1)
text = "100%"

[node name="VolumeSlider" type="HSlider" parent="CenterContainer/OuterVBox/Panel/Margin/VBoxContainer/VolumeRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 24)
layout_mode = 2
min_value = 0.0
max_value = 100.0
step = 1.0
value = 100.0

[node name="FullscreenRow" type="HBoxContainer" parent="CenterContainer/OuterVBox/Panel/Margin/VBoxContainer"]
layout_mode = 2

[node name="FullscreenLabel" type="Label" parent="CenterContainer/OuterVBox/Panel/Margin/VBoxContainer/FullscreenRow"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 16
text = "Fullscreen"

[node name="FullscreenCheck" type="CheckButton" parent="CenterContainer/OuterVBox/Panel/Margin/VBoxContainer/FullscreenRow"]
unique_name_in_owner = true
layout_mode = 2

[node name="KeybindLabel" type="Label" parent="CenterContainer/OuterVBox/Panel/Margin/VBoxContainer"]
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "Keybindings"
horizontal_alignment = 0

[node name="KeybindContainer" type="VBoxContainer" parent="CenterContainer/OuterVBox/Panel/Margin/VBoxContainer"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 4

[node name="ResetKeybindsButton" type="Button" parent="CenterContainer/OuterVBox/Panel/Margin/VBoxContainer"]
layout_mode = 2
theme_override_font_sizes/font_size = 13
theme_override_colors/font_color = Color(0.65, 0.7, 0.65, 1)
text = "Reset to Defaults"
script = ExtResource("4_link")

[node name="ButtonContainer" type="VBoxContainer" parent="CenterContainer/OuterVBox"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="BackButton" type="Button" parent="CenterContainer/OuterVBox/ButtonContainer"]
custom_minimum_size = Vector2(360, 36)
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "← BACK"
script = ExtResource("4_link")

[connection signal="value_changed" from="CenterContainer/OuterVBox/Panel/Margin/VBoxContainer/VolumeRow/VolumeSlider" to="." method="_on_volume_slider_value_changed"]
[connection signal="toggled" from="CenterContainer/OuterVBox/Panel/Margin/VBoxContainer/FullscreenRow/FullscreenCheck" to="." method="_on_fullscreen_check_toggled"]
[connection signal="pressed" from="CenterContainer/OuterVBox/Panel/Margin/VBoxContainer/ResetKeybindsButton" to="." method="_on_reset_keybinds_pressed"]
[connection signal="pressed" from="CenterContainer/OuterVBox/ButtonContainer/BackButton" to="." method="_on_back_pressed"]
