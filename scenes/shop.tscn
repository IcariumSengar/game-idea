[gd_scene load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/shop.gd" id="1_shop"]
[ext_resource type="Script" path="res://scripts/skill_tree_view.gd" id="1_skill_tree"]
[ext_resource type="StyleBoxFlat" path="res://resources/panel_dark.tres" id="2_panel_dark"]
[ext_resource type="Script" path="res://scripts/night_sky_background.gd" id="6_sky"]
[ext_resource type="Script" path="res://scripts/menu_link_button.gd" id="7_link"]

[node name="Shop" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_shop")

[node name="NightSky" type="Control" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("6_sky")

[node name="ShopPanel" type="PanelContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -320.0
offset_top = -350.0
offset_right = 320.0
offset_bottom = 350.0
grow_horizontal = 2
grow_vertical = 2
theme_override_styles/panel = ExtResource("2_panel_dark")

[node name="Margin" type="MarginContainer" parent="ShopPanel"]
theme_override_constants/margin_left = 28
theme_override_constants/margin_top = 24
theme_override_constants/margin_right = 28
theme_override_constants/margin_bottom = 24

[node name="VBox" type="VBoxContainer" parent="ShopPanel/Margin"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="TitleLabel" type="Label" parent="ShopPanel/Margin/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 32
text = "SANCTUM"
horizontal_alignment = 1

[node name="PlayerCurrencyLabel" type="Label" parent="ShopPanel/Margin/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 18
theme_override_colors/font_color = Color(0.9, 0.8, 0.3, 1)
text = "Essence: 0"
horizontal_alignment = 1

[node name="BackpackCurrencyLabel" type="Label" parent="ShopPanel/Margin/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 18
theme_override_colors/font_color = Color(0.3, 0.75, 0.9, 1)
text = "Stardust: 0"
horizontal_alignment = 1

[node name="Spacer1" type="Control" parent="ShopPanel/Margin/VBox"]
custom_minimum_size = Vector2(0, 6)
layout_mode = 2

[node name="TreesContainer" type="HBoxContainer" parent="ShopPanel/Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 20
size_flags_vertical = 3
size_flags_horizontal = 3

[node name="BackpackColumn" type="VBoxContainer" parent="ShopPanel/Margin/VBox/TreesContainer"]
layout_mode = 2
theme_override_constants/separation = 4
size_flags_horizontal = 3

[node name="BackpackHeader" type="Label" parent="ShopPanel/Margin/VBox/TreesContainer/BackpackColumn"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 13
theme_override_colors/font_color = Color(0.35, 0.75, 0.85, 1)
text = "STARDUST TREE
0 levels bought"
horizontal_alignment = 1

[node name="BackpackTreeView" type="Control" parent="ShopPanel/Margin/VBox/TreesContainer/BackpackColumn"]
unique_name_in_owner = true
layout_mode = 2
script = ExtResource("1_skill_tree")
size_flags_vertical = 3

[node name="PlayerColumn" type="VBoxContainer" parent="ShopPanel/Margin/VBox/TreesContainer"]
layout_mode = 2
theme_override_constants/separation = 4
size_flags_horizontal = 3

[node name="PlayerHeader" type="Label" parent="ShopPanel/Margin/VBox/TreesContainer/PlayerColumn"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 13
theme_override_colors/font_color = Color(0.85, 0.7, 0.35, 1)
text = "ESSENCE TREE
0 levels bought"
horizontal_alignment = 1

[node name="PlayerTreeView" type="Control" parent="ShopPanel/Margin/VBox/TreesContainer/PlayerColumn"]
unique_name_in_owner = true
layout_mode = 2
script = ExtResource("1_skill_tree")
size_flags_vertical = 3

[node name="ButtonContainer" type="VBoxContainer" parent="."]
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = 350.0
offset_top = -180.0
offset_right = 610.0
offset_bottom = 180.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 16
alignment = 1

[node name="SpellSelectorLabel" type="Label" parent="ButtonContainer"]
layout_mode = 2
theme_override_font_sizes/font_size = 13
theme_override_colors/font_color = Color(0.65, 0.7, 0.65, 1)
text = "ACTIVE SPELL"
horizontal_alignment = 1

[node name="ArcaneBoltButton" type="Button" parent="ButtonContainer"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(0, 30)
theme_override_font_sizes/font_size = 16
text = "Arcane Bolt"
script = ExtResource("7_link")

[node name="InfernoBladeButton" type="Button" parent="ButtonContainer"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(0, 30)
theme_override_font_sizes/font_size = 16
text = "Inferno Blade"
script = ExtResource("7_link")

[node name="FrostNovaButton" type="Button" parent="ButtonContainer"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(0, 30)
theme_override_font_sizes/font_size = 16
text = "Frost Nova"
script = ExtResource("7_link")

[node name="Spacer2" type="Control" parent="ButtonContainer"]
custom_minimum_size = Vector2(0, 10)
layout_mode = 2

[node name="StartRunButton" type="Button" parent="ButtonContainer"]
layout_mode = 2
custom_minimum_size = Vector2(0, 36)
theme_override_font_sizes/font_size = 22
text = "Start Run"
script = ExtResource("7_link")

[node name="BackButton" type="Button" parent="ButtonContainer"]
layout_mode = 2
custom_minimum_size = Vector2(0, 36)
theme_override_font_sizes/font_size = 16
text = "← BACK"
script = ExtResource("7_link")

[connection signal="pressed" from="ButtonContainer/ArcaneBoltButton" to="." method="_on_spell_button_pressed" binds = [&"arcane_bolt"]]
[connection signal="pressed" from="ButtonContainer/InfernoBladeButton" to="." method="_on_spell_button_pressed" binds = [&"inferno_blade"]]
[connection signal="pressed" from="ButtonContainer/FrostNovaButton" to="." method="_on_spell_button_pressed" binds = [&"frost_nova"]]
[connection signal="pressed" from="ButtonContainer/StartRunButton" to="." method="_on_start_run_button_pressed"]
[connection signal="pressed" from="ButtonContainer/BackButton" to="." method="_on_back_pressed"]
